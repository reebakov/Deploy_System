#JIRA GET
JIRA_1_SERVER=
JIRA_1_USER=
JIRA_1_TOKEN=

#JIRA MARVIN (Insight)
JIRA_2_SERVER=
JIRA_2_USER=
JIRA_2_TOKEN=

#MATTERMOST
MATTERMOST_WEBHOOK=

# Dashboard auth (по умолчанию admin / changeme; слабый пароль даёт только предупреждение в логе)
DASH_USER=
DASH_PASS=
# Секрет CSRF (необязательно; по умолчанию генерируется при старте)
CSRF_SECRET=
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_SECONDS=300
DASH_TIMEZONE=Asia/Novosibirsk

# Paths
ANSIBLE_CWD=
INVENTORY_PATH=
DEPLOY_LOG_DIR=
APP_LOG_FILE=/var/log/deploy-bot.log
STATE_DIR=

# Retention / watchdog
LOG_RETENTION_DAYS=90
WATCHDOG_GRACE_SECONDS=600

# Ansible
ANSIBLE_TIMEOUT=3600

# Target group
TARGET_GROUP=

# Jira: выбор задач (значения по умолчанию совпадают с прежним поведением)
JIRA_PROJECT=ACC
# JIRA_JQL=project = ACC AND assignee is EMPTY AND status = "To Do"
JIRA_MAX_RESULTS=50
TASK_POKER=CLUBGG
TASK_ROLE=HMS NSK
TASK_EPICS=DR-401,DR-390
JIRA_DONE_TRANSITIONS=готово,done,решена,закрыто,closed
BOT_RETRY_COOLDOWN_MIN=30

# Insight
INSIGHT_STATUS_ATTR_ID=589
INSIGHT_ROOM_ATTR_ID=843
INSIGHT_STATUS_USED_VALUE=10
INSIGHT_STATUS_FREE_VALUE=18
INSIGHT_ROOM_VALUE=CAT-66314
# INSIGHT_GPU_MODELS=Intel UHD Graphics 630,...

DATABASE_URL=
